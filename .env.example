# ── MongoDB ───────────────────────────────────────────────────────────────────
# In Docker Compose, use the service name as the hostname (e.g. "mongo")
MONGO_URI=mongodb://localhost:27017
DB_NAME=dragon_travelers_guide

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random key for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── Images ────────────────────────────────────────────────────────────────────
# Directory where game images are stored and served from.
# In Docker this is the path inside the container (mounted volume).
IMAGES_DIR=images

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the browser is allowed to call the API from.
# Add your server's UI origin here for production.
ALLOWED_ORIGINS=http://localhost:5173
